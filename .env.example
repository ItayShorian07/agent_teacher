# LLMod.ai (keep the real key only in .env.local and in Vercel environment variables)
LLMOD_API_KEY=
LLMOD_BASE_URL=https://api.llmod.ai
# Use this instead of LLMOD_BASE_URL if your course provides a full endpoint URL:
# LLMOD_CHAT_COMPLETIONS_URL=https://.../chat/completions
LLMOD_MODEL=MB5R2CF-azure/gpt-5.4-mini
LLMOD_EMBEDDING_MODEL=MB5R2CF-azure/text-embedding-3-small
# Optional full endpoint override:
# LLMOD_EMBEDDINGS_URL=https://api.llmod.ai/v1/embeddings

# Required team metadata
GROUP_BATCH_ORDER_NUMBER=TBD_TBD
TEAM_NAME=Adaptive AI Teacher
BATEL_EMAIL=
ITAY_EMAIL=
BOAZ_EMAIL=

# Used by the architecture endpoint in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
