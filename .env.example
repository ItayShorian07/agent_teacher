# Copy this file to .env.local on a new machine. Never add real secrets here.
LLMOD_API_KEY=
LLMOD_BASE_URL=https://api.llmod.ai
LLMOD_MODEL=MB5R2CF-azure/gpt-5.4-mini
LLMOD_EMBEDDING_MODEL=MB5R2CF-azure/text-embedding-3-small

# Optional local fallback. Never enable this in a real production deployment.
ADAPTIVE_TEACHER_DEMO_MODE=false

# Required project metadata
GROUP_BATCH_ORDER_NUMBER=TBD_TBD
TEAM_NAME=Adaptive AI Teacher
BATEL_EMAIL=
ITAY_EMAIL=
BOAZ_EMAIL=
